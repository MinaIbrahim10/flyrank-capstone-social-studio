# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Database
DATABASE_URL=sqlite:///./data/social_studio.db

# Real publishing target
# Put the real Discord webhook only in .env
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME

# Publisher selected by configuration
REAL_PUBLISHER=discord

# Optional local AI
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b-it
AI_ENABLED=false

# Scheduler
SCHEDULER_POLL_SECONDS=2
